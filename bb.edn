{:paths ["src" "resources"]
 :min-bb-version "1.13.220"
 :bbin/bin {html-channel {:main-opts ["-m" "html-channel.cli"]}}

 :tasks
 {serve {:doc "Run the server from this checkout (args pass through, e.g. --root examples)"
         :task (apply shell "bb -m html-channel.cli serve" *command-line-args*)}

  build {:doc "Compile runtime/ -> resources/html_channel/kit/; copy CONVENTION.md and the skill (needs `npm i` once)"
         :requires ([babashka.fs :as fs]
                    [clojure.string :as str])
         :task (let [kit "resources/html_channel/kit"]
                 (fs/delete-tree "build")
                 ;; sorted: squint's gensym counter runs across files, so compile order shows in the output,
                 ;; and glob order differs by filesystem (CI diffs the committed build on macOS and Linux)
                 (apply shell "npx squint compile --paths runtime --output-dir build"
                        (sort (map str (fs/glob "runtime" "**.cljs"))))
                 (fs/delete-tree kit)
                 ;; make modules self-contained: point each at the local copy of squint core
                 (doseq [f (fs/glob "build" "**.mjs")
                         :let [rel (str (fs/relativize "build" f))
                               depth (count (filter #{\/} rel))
                               core (str (if (zero? depth) "./" (apply str (repeat depth "../"))) "squint-core.js")
                               out (fs/path kit rel)]]
                   (fs/create-dirs (fs/parent out))
                   (spit (fs/file out) (str/replace (slurp (fs/file f)) "'squint-cljs/core.js'" (str "'" core "'"))))
                 (fs/copy "node_modules/squint-cljs/src/squint/core.js" (fs/path kit "squint-core.js"))
                 (fs/copy "runtime/decide.css" (fs/path kit "decide.css"))
                 (fs/copy "runtime/boot.js" (fs/path kit "boot.js"))
                 (doseq [doc ["CONVENTION.md" "EXPLORABLE.md"]
                         dest ["resources/html_channel" "skill/html-channel"]]
                   (fs/create-dirs dest)
                   (fs/copy doc (fs/path dest doc) {:replace-existing true}))
                 ;; agents fetch EXPLORABLE.md from the server, like example.html
                 (fs/copy "EXPLORABLE.md" (fs/path kit "EXPLORABLE.md"))
                 ;; the demo doubles as the worked example agents read: served at /_kit/example.html, shipped in the skill
                 (doseq [dest [(fs/path kit "example.html") "skill/html-channel/example.html"]]
                   (fs/copy "examples/demo/cache-layer-review.html" dest {:replace-existing true}))
                 ;; the golden explorable: served at /_kit/example-explorable.html, shipped in the skill
                 (doseq [dest [(fs/path kit "example-explorable.html") "skill/html-channel/example-explorable.html"]]
                   (fs/copy "examples/explorable/hash-table-growth.html" dest {:replace-existing true}))
                 ;; the plugin bundles a copy of the skill
                 (fs/delete-tree "plugin/skills")
                 (fs/copy-tree "skill" "plugin/skills")
                 (println "built" kit))}

  test {:doc "Unit tests, then browser and MCP end-to-end tests (needs .venv with playwright)"
        :task (do (shell "bb -cp src:resources:test -m html-channel.test-runner")
                  (doseq [t ["test/e2e.py" "test/takeover.py" "test/mcp_e2e.py" "test/revisions.py" "test/rich.py" "test/explorable.py" "test/code_links.py"]]
                    (shell ".venv/bin/python" t)))}}}
